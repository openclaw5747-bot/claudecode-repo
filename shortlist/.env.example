# Copy to .env and fill in what you use. Everything is optional except an AI provider.

# Sign-in password. Leave empty to run without one (only safe on 127.0.0.1).
SHORTLIST_PASSWORD=

# Where to listen. Keep 127.0.0.1 unless it sits behind HTTPS and a password.
HOST=127.0.0.1
PORT=3000

# AI provider: "anthropic" (hosted Claude) or "ollama" (a local model; nothing leaves your machine).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b

# UK job sources (both free). Reed: https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
